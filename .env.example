# Copy to .env in the directory where you launch Hotpath. Loaded automatically.
OPENAI_API_KEY=
# Optional: workers on an OpenAI-compatible endpoint such as Baseten
BASETEN_API_KEY=
# Paste your Sentry Python/FastAPI project DSN into .env, then restart Hotpath.
SENTRY_DSN=
HOTPATH_ENV=development
# Capture every trace and profiling session for the demo; lower for production.
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILE_SESSION_SAMPLE_RATE=1.0
SENTRY_SEND_DEFAULT_PII=false
# Optional release override (default: hotpath@<package version>)
SENTRY_RELEASE=
